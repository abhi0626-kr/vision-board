rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secret notes: keyed by userId
    match /secret_notes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User profiles: keyed by userId
    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User reflections: keyed by userId
    match /user_reflections/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vision board theories: contains userId field
    match /vision_theories/{theoryId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Vision board wishes: contains userId field
    match /vision_wishes/{wishId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Vision board images: contains userId field
    match /vision_images/{imageId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Vision board videos: contains userId field
    match /vision_videos/{videoId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
